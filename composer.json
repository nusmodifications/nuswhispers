{
  "name": "nusmodifications/nuswhispers",
  "description": "NUSWhispers source. Powered by Laravel + Angular",
  "keywords": [
    "nuswhispers",
    "nusmods",
    "nusmodifications",
    "laravel"
  ],
  "license": "MIT",
  "type": "project",
  "require": {
    "php": "^8.5.12",
    "ext-json": "*",
    "anlutro/l4-settings": "^1.4.3",
    "bugsnag/bugsnag-laravel": "^2.31",
    "google/recaptcha": "^1.3",
    "guzzlehttp/guzzle": "^7.10",
    "joelbutcher/facebook-graph-sdk": "^6.1.2",
    "laravel/framework": "^13.0",
    "laravel/socialite": "^5.31",
    "laravel/ui": "^4.6.3",
    "predis/predis": "^3.7",
    "symfony/http-client": "^8.0",
    "symfony/mailgun-mailer": "^8.0"
  },
  "require-dev": {
    "barryvdh/laravel-ide-helper": "^3.7",
    "fakerphp/faker": "^1.24",
    "larastan/larastan": "^3.0",
    "mockery/mockery": "^1.6",
    "nunomaduro/collision": "^8.9",
    "php-coveralls/php-coveralls": "^2.9",
    "phpstan/phpstan": "^2.3",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpstan/phpstan-mockery": "^2.0",
    "phpunit/phpunit": "^12.5",
    "roave/security-advisories": "dev-latest"
  },
  "autoload": {
    "psr-4": {
      "NUSWhispers\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "NUSWhispers\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "dont-discover": []
    }
  },
  "scripts": {
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate"
    ],
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ],
    "ide-helper": [
      "@php artisan ide-helper:generate",
      "@php artisan ide-helper:meta"
    ],
    "test": "@php vendor/bin/phpunit",
    "analyse": "@php vendor/bin/phpstan analyse --memory-limit=1G"
  },
  "config": {
    "preferred-install": "dist",
    "sort-packages": true,
    "optimize-autoloader": true,
    "platform": {
      "php": "8.5.12"
    },
    "platform-check": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  }
}
